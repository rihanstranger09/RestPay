# Required for real PayPal sandbox checkout.
# PayPal Developer Dashboard > Apps & Credentials > Sandbox app.
# Leave blank only when using the clearly labelled checkout simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Public base URL used for PayPal return/cancel links (no trailing slash).
APP_BASE_URL=http://localhost:3000
PORT=3000
# Optional override for the sample-purchase CLI (defaults to APP_BASE_URL).
DEMO_BASE_URL=http://localhost:3000

# Required for the LLM-enabled demo: any OpenAI-compatible chat completions provider.
# Without these values RestPay uses its transparent local parser.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: verify PayPal webhooks at POST /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=
